from PIL import Image, ImageDraw, ImageFont

def draw_text_wrapped_ja(draw, text, font, max_width, position, fill):
    """
    Draws text with automatic wrapping (character-based for Japanese).
    Uses textbbox for safe line height even when text is empty.
    """
    x, y = position
    lines = []
    current_line = ""

    for char in text:
        test_line = current_line + char
        bbox = draw.textbbox((0, 0), test_line, font=font)
        width = bbox[2] - bbox[0]

        if width <= max_width:
            current_line = test_line
        else:
            lines.append(current_line)
            current_line = char

    if current_line:
        lines.append(current_line)

    # Calculate line height safely (avoids NameError when text is empty)
    dummy_bbox = draw.textbbox((0, 0), "あ", font=font)
    line_height = dummy_bbox[3] - dummy_bbox[1] + 5

    for i, line in enumerate(lines):
        draw.text((x, y + i * line_height), line, font=font, fill=fill)

def composite_card(art_path, frame_path, card_data, output_path):
    # 1. Setup Canvas
    frame = Image.open(frame_path).convert("RGBA")
    art = Image.open(art_path).convert("RGBA")
    
    # Resize art to fit window (Example window size)
    window_size = (600, 800)
    art = art.resize(window_size, resample=Image.Resampling.LANCZOS)
    
    # 2. Composite
    canvas = Image.new("RGBA", frame.size)
    canvas.paste(art, (50, 50)) # Offset for art position
    canvas.alpha_composite(frame)
    
    # 3. Draw Text
    draw = ImageDraw.Draw(canvas)
    try:
        title_font = ImageFont.truetype("arial.ttf", 60)
        desc_font = ImageFont.truetype("arial.ttf", 30)
    except:
        title_font = ImageFont.load_default()
        desc_font = ImageFont.load_default()
        
    # Title
    draw.text((100, 50), card_data['title'], font=title_font, fill="white")
    
    # Description with wrapping (Japanese-safe)
    draw_text_wrapped_ja(
        draw, 
        card_data['effect_text'], 
        desc_font, 
        max_width=500, 
        position=(100, 900), 
        fill="white"
    )
    
    canvas.save(output_path)

from google import genai
from google.genai import types
from PIL import Image
from io import BytesIO
import time

def generate_card_art(prompt: str, style_ref_path: str, output_path: str, api_key: str):
    """
    Generates card artwork using Gemini with a style reference.
    Args:
        prompt: Description of the card illustration.
        style_ref_path: Path to the image defining the art style.
    """
    client = genai.Client(api_key=api_key)

    try:
        style_img = Image.open(style_ref_path)
    except FileNotFoundError:
        print(f"Error: Style image not found at {style_ref_path}")
        return

    # StyleReferenceImage: placement (contents vs config) may vary by SDK version.
    # Check the latest google-genai docs for your release.
    style_ref = types.StyleReferenceImage(
        reference_id=1,
        reference_image=style_img,
        config=types.StyleReferenceConfig(
            style_description="Dark fantasy oil painting, heavy texture, dramatic lighting"
        )
    )

    print(f"Generating: {prompt}...")

    try:
        # Use image-capable model (e.g. Gemini 2.0 Flash Exp or Gemini 3 Pro Image).
        # Response structure: candidates[0].content.parts with inline_data.
        response = client.models.generate_content(
            model="gemini-2.0-flash-exp-image-generation",
            contents=[prompt, style_ref],
            config=types.GenerateContentConfig(
                response_modalities=["Text", "Image"],
                image_config=types.ImageConfig(aspect_ratio="3:4"),
            ),
        )

        if not response.candidates:
            print("No image generated (safety filter or error).")
            return

        for part in response.candidates[0].content.parts:
            if part.inline_data is not None and part.inline_data.data:
                img = Image.open(BytesIO(part.inline_data.data))
                img.save(output_path)
                print(f"Saved to {output_path}")
                return

        print("No image part in response.")

    except Exception as e:
        print(f"API Error: {e}")
        # In a real loop, consider time.sleep() and retry (e.g. on 429)
